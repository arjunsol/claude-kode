{
  "name": "Kode Dot",
  "url": "https://kode.diy",
  "vendor": "kode.",
  "frameworks": ["arduino"],
  "connectivity": ["wifi", "bluetooth"],
  "build": {
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "dio",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_USB_CDC_ON_BOOT=1",
      "-DBOARD_HAS_PSRAM"
    ],
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "partitions": "partitions_app.csv",
      "memory_type": "opi_opi"
    },
    "hwids": [["0x303A", "0x1001"]]
  },
  "upload": {
    "flash_size": "32MB",
    "maximum_ram_size": 524288,
    "maximum_size": 33554432,
    "require_upload_port": true,
    "speed": 921600
  },
  "debug": {
    "openocd_target": "esp32s3.cfg"
  }
}
